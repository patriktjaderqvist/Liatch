# Copy to /srv/projects/liatch/.env on hertznet.
# Generate POSTGRES_PASSWORD and SECRET_KEY with:
#   openssl rand -base64 32 | tr -d '=+/' | head -c 32

POSTGRES_PASSWORD=replace-with-32-char-random

DB_URL=postgresql+psycopg2://liatch:replace-with-32-char-random@db:5432/liatch
SECRET_KEY=replace-with-64-char-hex
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Run the seed (idempotent upsert) on every container start so demo data
# survives volume resets. Flip to 0 once you've got real users.
SEED_ON_START=1

# Optional: enable AI internship recommendations via Groq.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_TIMEOUT_SECONDS=15
