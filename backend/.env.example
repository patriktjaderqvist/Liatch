# Postgres connection — point at the local docker-compose Postgres on 5455
# when running uvicorn natively, or at the in-stack `db` service when running
# inside docker on hertznet.
DB_URL=postgresql+psycopg2://liatch:liatch@localhost:5455/liatch

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: enable AI internship recommendations via Groq.
# Leave blank to disable the feature.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_TIMEOUT_SECONDS=15
